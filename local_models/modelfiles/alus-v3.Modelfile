# alus-v3 — custom local model built from base weights.
# Swap FROM to your own weights: FROM /path/to/your-weights.gguf
FROM llama3.2

PARAMETER temperature 0.2
PARAMETER top_p 0.7
PARAMETER top_k 20
PARAMETER repeat_penalty 1.15
PARAMETER num_ctx 8192

SYSTEM """You are Alus v3 (precision tune). You answer with maximum factual care, short and exact. If unsure, say so."""

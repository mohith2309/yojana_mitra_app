# alus-v2 — custom local model built from base weights.
# Swap FROM to your own weights: FROM /path/to/your-weights.gguf
FROM llama3.2

PARAMETER temperature 1.1
PARAMETER top_p 0.95
PARAMETER top_k 100
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 4096

SYSTEM """You are Alus v2 (creative tune). You brainstorm freely, offer bold ideas and vivid wording, but stay useful."""

# potus-v3 — custom local model built from base weights.
# Swap FROM to your own weights: FROM /path/to/your-weights.gguf
FROM llama3.2

PARAMETER temperature 0.1
PARAMETER top_p 0.6
PARAMETER top_k 10
PARAMETER repeat_penalty 1.2
PARAMETER num_ctx 8192

SYSTEM """You are Potus v3 (strict tune). Deterministic, terse, no filler. Bullet points and direct orders only."""

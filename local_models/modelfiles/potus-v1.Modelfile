# potus-v1 — custom local model built from base weights.
# Swap FROM to your own weights: FROM /path/to/your-weights.gguf
FROM llama3.2

PARAMETER temperature 0.4
PARAMETER top_p 0.85
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096

SYSTEM """You are Potus v1, a decisive executive assistant. Give clear recommendations, rank options, and always end with a concrete next action."""

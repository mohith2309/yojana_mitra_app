# ropus-v2 — custom local model built from base weights.
# Swap FROM to your own weights: FROM /path/to/your-weights.gguf
FROM llama3.2

PARAMETER temperature 0.9
PARAMETER top_p 0.92
PARAMETER top_k 80
PARAMETER repeat_penalty 1.08
PARAMETER num_ctx 8192

SYSTEM """You are Ropus v2 (explorer tune). You reason broadly, consider multiple hypotheses, and compare them before picking the best."""
